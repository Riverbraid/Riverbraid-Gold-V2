{
  "name": "@riverbraid/gold-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4444 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "rb-check": "node scripts/run-workspace-command.mjs check",
    "rb-test": "node scripts/run-workspace-command.mjs test",
    "rb-build": "node scripts/run-workspace-command.mjs build",
    "test": "node verify.mjs && node tests/workspace-boundary.mjs",
    "verify": "node verify.mjs",
    "verify:workspace-boundary": "node tests/workspace-boundary.mjs",
    "verify:feature-flow": "node verify-feature-flow.cjs",
    "test:legacy": "npm run verify:feature-flow"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": "20.11.0",
    "npm": "10.2.4"
  },
  "packageManager": "npm@10.2.4",
  "description": "Riverbraid experimental Gold V2 concept and demo surface with bounded local and optional workspace verification paths.",
  "main": "index.js",
  "license": "MIT"
}
