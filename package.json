{
  "name": "@riverbraid/gold-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4444 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "rb-check": "tsc && cd ../riverbraid-tsh && cargo check",
    "rb-test": "cd ../riverbraid-tsh && cargo test",
    "rb-build": "npm run build && cd ../riverbraid-wasm-bridge && wasm-pack build",
    "test": "node verify.mjs",
    "verify:feature-flow": "node verify-feature-flow.cjs",
    "test:legacy": "npm run verify:feature-flow",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  },
  "description": "Riverbraid Gold petal for deterministic stationarity verification.",
  "main": "index.js",
  "license": "MIT"
}
